     ggml_moe_prefetch_node(node);
 }
 
+int ggml_moe_hot_experts_count(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char * env = getenv("IK_HOT_EXPERTS");
+        cached = (env && env[0]) ? std::max(0, atoi(env)) : 0;
+    }
+    return cached;
+}
+
+void ggml_moe_cold_tail_advise(const struct ggml_tensor * w0, const struct ggml_tensor * w1, const struct ggml_tensor * ids) {
+    const int k_hot = ggml_moe_hot_experts_count();
+    if (k_hot <= 0 || !w0 || !w0->data || !ids || !ids->data) return;
+    if (w0->ne[2] <= k_hot) return;
+    const long page = sysconf(_SC_PAGESIZE);
+    const uintptr_t pmask = (uintptr_t)(page - 1);
+    auto advise_tensor = [&](const struct ggml_tensor * w) {
+        if (!w || !w->data || w->ne[2] <= k_hot) return;
+        const size_t stride = w->nb[2];
+        const size_t wbytes = ggml_nbytes(w);
+        const char * base = (const char *)w->data;
+        for (int64_t i1 = 0; i1 < ids->ne[1]; ++i1) {
+            for (int64_t i0 = 0; i0 < ids->ne[0]; ++i0) {
+                const int32_t id = *(const int32_t *)((const char *)ids->data + i1*ids->nb[1] + i0*ids->nb[0]);
+                if (id < k_hot || id >= w->ne[2]) continue;
+                const size_t off = (size_t)id * stride;
+                const size_t len = std::min(stride, wbytes - off);
+                if (off < wbytes && len > 0) {
+                    const uintptr_t s = (uintptr_t)(base + off);
+                    const uintptr_t a = s & ~pmask;
+                    (void) madvise((void *)a, (size_t)(s + len - a), MADV_COLD);
+                }
+            }
+        }
+    };
+    advise_tensor(w0);
+    if (w1) advise_tensor(w1);
+}
+
+void ggml_ple_row_advise_cold(const void * row_ptr, size_t row_bytes) {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char * env = getenv("IK_PLE_MADV_COLD");
+        enabled = (env && env[0] == '0') ? 0 : 1; // enabled by default for huge PLE tables
+    }
+    if (!enabled || !row_ptr || row_bytes == 0) return;
+    static long page = 0;
+    if (page == 0) page = sysconf(_SC_PAGESIZE);
+    const uintptr_t s = (uintptr_t)row_ptr;
+    const uintptr_t a = s & ~(uintptr_t)(page - 1);
+    const size_t len = ((s + row_bytes + (uintptr_t)page - 1) & ~(uintptr_t)(page - 1)) - a;
+    (void) madvise((void *)a, len, MADV_COLD);
+}
+
+void ggml_moe_warm_hot_prefix(const void * data, size_t hot_bytes, size_t total_bytes) {
+    if (!data || total_bytes == 0) return;
+    const long page = sysconf(_SC_PAGESIZE);
+    const uintptr_t pmask = (uintptr_t)(page - 1);
+    const uintptr_t base = (uintptr_t)data;
+    if (hot_bytes < total_bytes) {
+        const uintptr_t cs = (base + hot_bytes + pmask) & ~pmask;
+        const uintptr_t ce = (base + total_bytes) & ~pmask;
+        if (ce > cs) {
+            (void) madvise((void *)cs, ce - cs, MADV_RANDOM);
+            (void) madvise((void *)cs, ce - cs, MADV_DONTNEED);
+        }
+    }
+    if (hot_bytes > 0) {
+        const uintptr_t hs = base & ~pmask;
+        const uintptr_t he = (base + std::min(hot_bytes, total_bytes) + pmask) & ~pmask;
+        if (he > hs) {
+            (void) madvise((void *)hs, he - hs, MADV_WILLNEED);
+            (void) madvise((void *)hs, he - hs, MADV_POPULATE_READ);
+        }
+    }
+}
